# Environment template — copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.

# --- Database ---
DATASOURCE_URL=jdbc:postgresql://localhost:5432/app1db
DATASOURCE_USERNAME=app1user
DATASOURCE_PASSWORD=

# --- Security ---
# Generate with: openssl rand -base64 64
JWT_SECRET=

# --- CORS ---
CORS_ORIGINS=http://localhost:4200

# --- Company identity (shown on quotes/PDFs) ---
COMPANY_NAME=
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_SIREN=

# --- Email (Mailjet Send API v3.1) ---
EMAIL_ENABLED=true
MAILJET_API_URL=https://api.mailjet.com/v3.1/send
MAILJET_API_KEY=
MAILJET_API_SECRET=
EMAIL_SENDER_ADDRESS=noreply@kreadevis.fr
EMAIL_SENDER_NAME=Kreadevis
